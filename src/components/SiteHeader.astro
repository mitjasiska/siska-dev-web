---
import markUrl from '../assets/brand/mark.svg?url';
import GitHub from '../assets/icons/github.svg';
import LinkedIn from '../assets/icons/linkedin.svg';
import X from '../assets/icons/x.svg';

// Set an X profile URL and enable it here when an account is available.
const socialLinks = [
	{ label: 'GitHub', href: 'https://github.com/mitjasiska', Icon: GitHub, width: 24, height: 24, visible: true },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/mitjasiska', Icon: LinkedIn, width: 22, height: 22, visible: true },
	{ label: 'X', href: '/', Icon: X, width: 19, height: 20, visible: false },
];

const siteLinks = [
	{ label: 'Writings', href: '/writings' },
	{ label: 'Projects', href: '/projects' },
	{ label: 'About', href: '/about' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '');
---

<header class="site-header page-container">
	<a class="site-identity" href="/" aria-label="siska.dev home">
		<img src={markUrl} width="36" height="36" alt="" />
		<span>siska.dev</span>
	</a>
	<nav class="site-nav" aria-label="Site navigation">
		{siteLinks.map(({ label, href }) => (
			<a href={href} aria-current={currentPath === href ? 'page' : currentPath.startsWith(`${href}/`) ? 'location' : undefined}>{label}</a>
		))}
	</nav>
	<nav class="social-links" aria-label="Social links">
		{socialLinks.filter(link => link.visible).map(({ label, href, Icon, width, height }) => (
			<a href={href} aria-label={label} target="_blank" rel="noopener noreferrer"><Icon width={width} height={height} aria-hidden="true" focusable="false" /></a>
		))}
	</nav>
</header>

<style>
	.site-header {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		gap: 16px;
		padding-block: 24px;
	}

	a { color: inherit; text-decoration: none; }
	a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }

	.site-identity {
		justify-self: start;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		font-size: 18px;
		font-weight: 500;
		letter-spacing: -.035em;
		white-space: nowrap;
	}

	.site-identity img { display: block; flex: none; transform: translateY(-1px); }
	nav { display: flex; align-items: center; }
	nav a { display: grid; place-items: center; min-height: 44px; color: rgb(34 34 38 / .65); }
	nav a:hover, nav a:focus-visible { color: var(--color-ink); }

	.site-nav { justify-self: center; gap: 24px; }
	.site-nav a { font-size: 16px; font-weight: 500; color: rgb(34 34 38 / .85); white-space: nowrap; }
	.site-nav a:hover, .site-nav a[aria-current] { color: var(--color-accent); }
	.site-nav a[aria-current] { font-weight: 600; }
	.social-links { justify-self: end; }
	.social-links a { width: 44px; height: 44px; }

	@media (min-width: 601px) and (max-height: 850px) {
		.site-header { padding-block: 18px; }
	}

	@media (max-width: 600px) {
		.site-header { gap: 8px; padding-block: 12px; }
		.site-identity { gap: 8px; font-size: 17px; }
		.site-nav { gap: 16px; }
		.site-nav a { font-size: 15px; }
	}

	@media (max-width: 520px) {
		/* Anchor the second row to the header edges with equally sized tap targets. */
		.site-header { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); row-gap: 8px; }
		.site-nav {
			grid-column: 1 / -1;
			grid-row: 2;
			justify-self: stretch;
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0;
			border-top: 1px solid rgb(34 34 38 / .12);
			padding-top: 4px;
		}
		.social-links { grid-column: 2; grid-row: 1; }
	}
</style>
