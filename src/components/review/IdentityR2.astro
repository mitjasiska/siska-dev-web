---
import hero from '../../assets/hero/hero-agent.svg?raw';
import r1Mark from '../../assets/brand/identity/r1/mark.svg?url';
import r1Favicon from '../../assets/brand/identity/r1/favicon.svg?url';
import markA from '../../assets/brand/identity/r2/mark-a.svg?url';
import iconA from '../../assets/brand/identity/r2/favicon-a.svg?url';
import markB from '../../assets/brand/identity/r2/mark-b.svg?url';
import iconB from '../../assets/brand/identity/r2/favicon-b.svg?url';
import markC from '../../assets/brand/identity/r2/mark-c.svg?url';
import iconC from '../../assets/brand/identity/r2/favicon-c.svg?url';

const sizes = [128, 64, 48, 32, 24, 20, 16];
const candidates = [
  { id: 'a', name: 'R2-A', title: 'Structured silhouette', mark: markA, icon: iconA,
    note: 'Longer split crown, straight terminal elbows and a two-stage jaw. The center stays empty.', recommended: true },
  { id: 'b', name: 'R2-B', title: 'Articulated scan head', mark: markB, icon: iconB,
    note: 'Retains the hero’s crown slashes and lower jaw elbows. Violet moves inside the black side scans.' },
  { id: 'c', name: 'R2-C', title: 'Forehead scan signal', mark: markC, icon: iconC,
    note: 'Keeps A’s silhouette. Violet moves to the paired forehead scan already present above INTENT in the hero; the side scans become black.' },
];
const comparison = [{name: 'R1', icon: r1Favicon, recommended: false}, ...candidates];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" sizes="any" href={r1Favicon} />
    <title>siska.dev / Revision 2</title>
  </head>
  <body><main>
    <nav aria-label="Identity revisions"><a href="/review/identity-r1">Revision 1</a><a href="/review/identity-r2" aria-current="page">Revision 2</a><span>Under review · production remains R1</span></nav>
    <header><p class="eyebrow">siska.dev / Revision 2</p><h1>A crown. Sides. A jaw.</h1><p>Refine the scan head without losing its fragmented construction.</p></header>
    <section class="small-test" aria-labelledby="compare-heading">
      <div class="section-heading"><h2 id="compare-heading">Revision 1 → Revision 2</h2><span>Favicon geometry · actual sizes</span></div>
      <div class="comparison-grid" style={`--columns:${comparison.length}`}>
        <span></span>{comparison.map(item => <h3 class:list={{selected: item.recommended}}>{item.name}{item.recommended && <small>Recommended R2</small>}</h3>)}
        {[64,32,16].map(size => <><span class="size-label">{size}px</span>{comparison.map(item => <div class="compare-cell"><img src={item.icon} width={size} height={size} alt={`${item.name} favicon at ${size}px`} /></div>)}</>)}
      </div>
      <div class="recommendation"><strong>Recommended R2 · A</strong><p>The broad split crown, upright side elbows and separate jaw steps remain distinct at 16–32px. B keeps more source detail but feels denser; C’s inner scan competes with the crown and introduces a facial reading. A keeps the center empty.</p></div>
    </section>
    <section aria-labelledby="tabs-heading">
      <div class="section-heading"><h2 id="tabs-heading">At browser-tab scale</h2><span>16px icons · 252 × 36px tabs</span></div>
      <div class="tab-comparison">{comparison.map(item => <div><h3>{item.name}</h3><div class="tab light"><img src={item.icon} width="16" height="16" alt={`${item.name} comparison light tab icon`} />siska.dev — Agentic software<span>×</span></div><div class="tab dark"><img src={item.icon} width="16" height="16" alt={`${item.name} comparison dark tab icon`} />siska.dev — Agentic software<span>×</span></div></div>)}</div>
    </section>
    <section class="lineage" aria-labelledby="lineage-heading">
      <div class="hero" set:html={hero} />
      <div><h2 id="lineage-heading">Finished hero → R1 → R2</h2><div class="lineage-marks"><figure><img src={r1Mark} width="64" height="64" alt="Revision 1 mark"/><figcaption>R1</figcaption></figure><span>→</span>{candidates.map(item => <figure><img src={item.mark} width="64" height="64" alt={`${item.name} mark`} /><figcaption>{item.name}</figcaption></figure>)}</div><p>The INTENT region supplies the paired crown scans, terminal elbows and tapering lower rows. All candidates preserve reflection symmetry, square ends, open space and the sparse violet signal.</p></div>
    </section>
    {candidates.map(item => <section class="candidate" id={`r2-${item.id}`} aria-labelledby={`heading-${item.id}`}>
      <div class="section-heading"><h2 id={`heading-${item.id}`}>{item.name} / {item.title}</h2>{item.recommended && <span class="badge">Recommended R2</span>}</div>
      <p>{item.note}</p>
      <h3>Identity mark</h3>
      <div class="sizes">{sizes.map(size => <figure><img src={item.mark} width={size} height={size} alt={`${item.name} mark at ${size}px`} /><figcaption>{size}px</figcaption></figure>)}</div>
      <h3>Favicon specialization</h3>
      <div class="sizes">{sizes.map(size => <figure><img src={item.icon} width={size} height={size} alt={`${item.name} favicon at ${size}px`} /><figcaption>{size}px</figcaption></figure>)}</div>
      <div class="contexts"><div class="wordmark"><img src={item.mark} width="32" height="32" alt=""/>siska.dev</div><div class="tab light"><img src={item.icon} width="16" height="16" alt={`${item.name} light tab icon`}/>siska.dev — Agentic software<span>×</span></div><div class="tab dark"><img src={item.icon} width="16" height="16" alt={`${item.name} dark tab icon`}/>siska.dev — Agentic software<span>×</span></div></div>
    </section>)}
    <footer>Review assets only. <a href="/review/identity-r1">The frozen Revision 1 remains available.</a></footer>
  </main></body>
</html>
<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; color: #222226; background: #fafafa; font: 14px system-ui, sans-serif; color-scheme: light; }
  main { max-width: 1140px; margin: auto; padding: 28px 40px 48px; }
  nav, .eyebrow, figcaption, .size-label, .wordmark, .tab, footer { font-family: monospace; }
  nav { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; font-size: 12px; }
  a { color: inherit; text-underline-offset: 4px; }
  nav [aria-current] { color: #7c3aed; }
  nav span { margin-left: auto; color: #74747c; font-size: 11px; }
  header { padding: 36px 0 24px; }
  .eyebrow { font-size: 12px; color: #74747c; }
  h1 { font-size: 38px; font-weight: 500; letter-spacing: -.04em; margin: 8px 0 12px; }
  h2 { font-size: 19px; font-weight: 500; margin: 0; }
  h3 { font-size: 12px; font-weight: 500; margin: 16px 0; }
  p { color: #686870; line-height: 1.65; }
  section { border-top: 1px solid #dedee4; padding: 26px 0; }
  .section-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .section-heading>span { color: #74747c; font: 11px monospace; }
  .comparison-grid { display: grid; grid-template-columns: 64px repeat(var(--columns), 1fr); gap: 18px 12px; align-items: center; margin-top: 12px; max-width: 820px; }
  .comparison-grid h3 { text-align: center; margin: 12px 0 0; }
  .comparison-grid h3.selected { color: #6d28d9; }
  .comparison-grid small { display: block; margin-top: 5px; font: 10px monospace; }
  .recommendation { display: grid; grid-template-columns: 190px 1fr; gap: 24px; margin-top: 24px; padding: 16px 20px; background: #f1eef8; }
  .recommendation strong { font: 12px monospace; color: #6d28d9; padding-top: 3px; }
  .recommendation p { margin: 0; font-size: 12px; max-width: 740px; }
  .tab-comparison { display: grid; grid-template-columns: repeat(auto-fit, 252px); gap: 16px; margin-top: 6px; }
  .tab-comparison .tab + .tab { margin-top: 8px; }
  .section-heading .badge { color: #6d28d9; background: #f1eef8; padding: 7px 10px; }
  .compare-cell { display: flex; justify-content: center; align-items: center; min-height: 32px; }
  .size-label { color: #74747c; font-size: 11px; }
  .lineage { display: grid; grid-template-columns: 180px 1fr; align-items: center; gap: 60px; }
  .hero { width: 180px; }
  .hero :global(svg) { display: block; width: 100%; height: auto; }
  .lineage-marks { display: flex; align-items: center; flex-wrap: wrap; gap: 36px; margin: 24px 0 16px; }
  .lineage p { max-width: 610px; }
  img { display: block; flex-shrink: 0; }
  figure { margin: 0; display: flex; align-items: center; flex-direction: column; gap: 12px; }
  figcaption { font-size: 11px; color: #74747c; }
  .sizes { display: flex; align-items: center; flex-wrap: wrap; gap: 42px; padding: 6px 0 24px; }
  .contexts { display: flex; align-items: center; flex-wrap: wrap; gap: 24px; margin-top: 4px; }
  .wordmark { display: flex; align-items: center; gap: 12px; font-size: 16px; }
  .tab { display: flex; align-items: center; gap: 8px; width: 252px; height: 36px; padding: 0 12px; border-radius: 8px 8px 0 0; font-size: 10px; white-space: nowrap; }
  .tab span { margin-left: auto; }
  .light { color-scheme: light; background: #e9e9ee; }
  .dark { color-scheme: dark; color: #fafafa; background: #222226; }
  footer { margin-top: 22px; color: #74747c; font-size: 11px; line-height: 1.7; }
  @media (max-width: 700px) {
    main { padding: 24px 16px; }
    nav { gap: 20px; }
    nav span { margin: 0; width: 100%; }
    h1 { font-size: 32px; }
    .section-heading { align-items: start; flex-direction: column; gap: 8px; }
    .comparison-grid { grid-template-columns: 36px repeat(var(--columns), 1fr); gap: 18px 4px; }
    .recommendation { grid-template-columns: 1fr; gap: 8px; padding: 16px; }
    .lineage { grid-template-columns: 1fr; gap: 24px; }
    .hero { width: 160px; }
    .lineage-marks { gap: 20px; }
    .sizes { gap: 26px; }
  }
</style>
