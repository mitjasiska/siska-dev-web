---
import heroAgent from '../assets/hero/hero-agent.svg?raw';
---

<div class="hero-agent" set:html={heroAgent} />

<style>
  .hero-agent {
    --hero-ink: var(--color-ink, #222226);
    --hero-accent: var(--color-accent, #7c3aed);
    --flow-duration: 10.8s;
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
  }

  .hero-agent :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* A region owns one color. Its word and every local fragment inherit it,
     retaining the SVG's original opacity hierarchy and resting geometry. */
  .hero-agent :global([data-part]) {
    --flow-track: workflow-flow;
    color: var(--hero-ink);
  }

  /* Crests, in tenths of a cycle:
     Intent → Plan → Build → Left → Right → Left → Right → Review → Commit → Deploy.
     Negative phases start an already-continuous loop, including Deploy → Intent. */
  .hero-agent :global([data-part="intent"]) { --flow-phase: 0; }
  .hero-agent :global([data-part="plan"]) { --flow-phase: -.9; }
  .hero-agent :global([data-part="build"]) { --flow-phase: -.8; }
  .hero-agent :global([data-part="agent-left"]) { --flow-phase: -.7; }
  .hero-agent :global([data-part="agent-right"]) { --flow-phase: -.6; }
  .hero-agent :global([data-part="review"]) { --flow-phase: -.3; }
  .hero-agent :global([data-part="commit"]) { --flow-phase: -.2; }
  .hero-agent :global([data-part="deploy"]) { --flow-phase: -.1; }

  .hero-agent :global(:is([data-part="agent-left"], [data-part="agent-right"])) {
    --flow-track: agent-flow;
  }

  /* Static neutral is the default, including reduced-motion preferences.
     There are no geometry, stroke-width or fragment-level animations. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-agent :global([data-part]) {
      animation: var(--flow-track) var(--flow-duration) ease-in-out infinite;
      animation-delay: calc(var(--flow-duration) * var(--flow-phase));
    }
  }

  /* Each smooth crest overlaps its neighbors; there is no held on/off step.
     Matching endpoint colors and easing make the loop seam continuous. */
  @keyframes workflow-flow {
    0%, 100% { color: var(--hero-accent); }
    13%, 87% { color: var(--hero-ink); }
  }

  /* Two gentle crests per agent. The valley retains activity while the
     opposite agent takes the lead, instead of blinking back to neutral. */
  @keyframes agent-flow {
    0%, 20%, 100% { color: var(--hero-accent); }
    10% { color: color-mix(in srgb, var(--hero-accent) 45%, var(--hero-ink)); }
    33%, 87% { color: var(--hero-ink); }
  }
</style>
