---
import HeroAgent from '../components/HeroAgent.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/typography.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=r2c" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Mitja Šiška — Software Engineer. Agentic development, developer tooling, and software systems." />
		<title>siska.dev — Agentic software development</title>
	</head>
	<body>
		<SiteHeader />
		<main>
			<section class="hero page-container" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span>Mitja Šiška / Software Engineer</p>
					<h1 id="hero-title">Building software with humans and agents.</h1>
					<p class="supporting-copy">Agentic development, developer tooling, and software systems.</p>
				</div>
				<div class="hero-artwork"><HeroAgent /></div>
			</section>
		</main>
	</body>
</html>

<style>
	:global(:root) {
		--color-ink: #222226;
		--color-accent: #7c3aed;
		font-family: var(--font-sans);
		color: var(--color-ink);
		background: #fafafa;
	}

	:global(*) { box-sizing: border-box; }
	:global(body) { margin: 0; }
	:global(.page-container) { width: 100%; max-width: 1440px; margin-inline: auto; padding-inline: clamp(20px, 4vw, 56px); }

	.hero {
		padding-top: clamp(40px, 6vh, 72px);
		padding-bottom: 32px;
		text-align: center;
	}

	.hero-copy { max-width: 820px; margin-inline: auto; }
	.eyebrow { display: flex; align-items: center; justify-content: center; gap: 10px; margin: 0 0 24px; font: 13px/1.6 var(--font-mono); }
	.eyebrow span { width: 6px; height: 6px; flex: none; background: var(--color-accent); }
	h1 { max-width: 760px; margin: 0 auto; font-size: clamp(44px, 5vw, 68px); font-weight: 500; line-height: 1.08; letter-spacing: -.045em; text-wrap: balance; }
	.supporting-copy { max-width: 620px; margin: 24px auto 0; font-size: 18px; line-height: 1.6; color: rgb(34 34 38 / .7); text-wrap: balance; }
	/* Size the existing component's stage; its SVG and workflow stay untouched. */
	.hero-artwork { width: min(100%, 432px); margin: 16px auto 0; }

	@media (min-width: 601px) and (max-height: 850px) {
		.hero { padding-top: 24px; padding-bottom: 20px; }
		.eyebrow { margin-bottom: 20px; }
		h1 { font-size: clamp(44px, 5vw, 60px); }
		.supporting-copy { margin-top: 18px; }
		.hero-artwork { width: min(100%, 358px); margin-top: 0; }
	}

	@media (max-width: 600px) {
		:global(body) { display: grid; grid-template-rows: auto minmax(0, 1fr); height: 100svh; }
		main { min-height: 0; }
		.hero {
			display: grid;
			grid-template-rows: auto minmax(0, 1fr);
			row-gap: clamp(4px, 1svh, 10px);
			height: 100%;
			padding: clamp(12px, 3svh, 28px) 12px clamp(12px, 2svh, 20px);
		}
		/* Give only the artwork extra room; keep the copy's existing 20px inset. */
		.hero-copy { width: 100%; padding-inline: 8px; }
		.eyebrow { gap: 8px; margin-bottom: clamp(12px, 2svh, 18px); font-size: 12px; }
		/* Scale the text measure with the type to preserve the balanced three-line wrap. */
		h1 { max-width: min(90%, 400px); font-size: clamp(31px, 9vw, 40px); line-height: 1.06; }
		.supporting-copy { max-width: 330px; margin-top: clamp(14px, 2svh, 18px); font-size: 16px; line-height: 1.5; }
		/* Fit the intact SVG into the space left by the actual header and copy. */
		.hero-artwork { width: min(100%, 360px); height: 100%; min-height: 0; max-height: calc(360px * 760 / 640); margin: 0 auto; }
		.hero-artwork :global(.hero-agent), .hero-artwork :global(.hero-agent svg) { height: 100%; }
	}
</style>
