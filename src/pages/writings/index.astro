---
import { getCollection } from 'astro:content';
import WritingsLayout from '../../layouts/WritingsLayout.astro';

const writings = (await getCollection('writings')).sort(
  (a, b) => b.data.published.getTime() - a.data.published.getTime() || a.id.localeCompare(b.id),
);
---

<WritingsLayout title="Writings" description="Long-form writing and papers on software engineering, agentic development, and developer tooling.">
  {writings.length === 0 ? (
    <p class="empty-state">No writings published yet.</p>
  ) : (
    <ul class="writings-list">
      {writings.map(({ id, data }) => (
        <li>
          <h2><a href={`/writings/${id}/`}>{data.title}</a></h2>
          <p>{data.description}</p>
          <time datetime={data.published.toISOString().slice(0, 10)}>
            {data.published.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}
          </time>
        </li>
      ))}
    </ul>
  )}
</WritingsLayout>

<style>
  .empty-state { border-top: 1px solid rgb(34 34 38 / .15); padding-top: 28px; margin: 0; font-size: 16px; line-height: 1.7; color: rgb(34 34 38 / .7); }
  .writings-list { list-style: none; padding: 0; margin: 0; }
  li { border-top: 1px solid rgb(34 34 38 / .15); padding-block: 28px 32px; }
  h2 { margin: 0; font-size: 25px; font-weight: 500; line-height: 1.25; letter-spacing: -.025em; }
  h2 a { color: var(--color-ink); text-decoration: none; }
  h2 a:hover, h2 a:focus-visible { color: var(--color-accent); text-decoration: underline; }
  p { margin: 12px 0 16px; font-size: 16px; line-height: 1.7; color: rgb(34 34 38 / .7); }
  time { font: 12px/1.6 var(--font-mono); color: rgb(34 34 38 / .7); }
</style>
